{
  "name": "snippet-editor-for-espanso",
  "productName": "Snippet Editor for Espanso",
  "desktopName": "snippet-editor-for-espanso.desktop",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "A desktop editor for Espanso snippets.",
  "author": "Daniel Kam",
  "license": "MIT",
  "main": "electron/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "demo": "node scripts/demo.mjs",
    "test": "node --test \"test/*.test.js\"",
    "test:ui": "electron test/ui-smoke.mjs",
    "test:hardening": "electron test/hardening-smoke.mjs",
    "test:quit": "node test/quit-smoke.mjs",
    "test:packaged": "node test/packaged-smoke.mjs",
    "mcp": "node mcp/server.mjs",
    "test:espanso": "node test/espanso-check.mjs",
    "icon": "node scripts/make-icon.mjs",
    "pack": "npm run build:expansion && electron-builder --dir",
    "dist": "npm run build:expansion && electron-builder --mac --win --linux",
    "dist:mac": "npm run build:expansion && electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "build:expansion": "node scripts/build-expansion.mjs"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "htm": "3.1.1"
  }
}
